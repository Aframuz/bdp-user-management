{
	# El endpoint de administración no se usa y escucha en 2019 por defecto.
	admin off
	# Sin TLS: el certificado lo gestiona Apache en el host, que termina el
	# HTTPS y reenvía en claro a este contenedor por 127.0.0.1.
	auto_https off

	servers {
		# Imprescindible detrás de Apache. Por defecto Caddy REESCRIBE
		# X-Forwarded-Proto con el esquema de su propia conexión (http), y
		# entonces Laravel genera URLs absolutas http:// que el navegador
		# bloquea como contenido mixto: la página carga sin estilos ni JS.
		# Declarando de quién viene el tráfico, Caddy conserva las cabeceras
		# X-Forwarded-* originales (y con ellas la IP real del visitante).
		trusted_proxies static private_ranges
	}
}

# Caddy sirve HTTP plano y solo escucha en la red interna de compose: en el
# servidor el puerto se publica atado a 127.0.0.1, nunca a 0.0.0.0.
:8080 {
	root * /var/www/html/public
	encode zstd gzip

	header {
		-Server
		# Apache reenvía estas cabeceras tal cual en la respuesta HTTPS.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Vite emite nombres con hash, así que el bundle es cacheable para siempre.
	@assets path /build/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# `php_fastcgi` ya resuelve el try_files hacia index.php del front
	# controller, y reenvía las cabeceras X-Forwarded-* que pone Apache para
	# que Laravel reconstruya la URL original en https.
	php_fastcgi app:9000
	file_server

	log {
		output stdout
		format json
	}
}
