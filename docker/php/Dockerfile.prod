# syntax=docker/dockerfile:1.7

# Imagen de producción. Un mismo árbol de fuentes produce dos objetivos:
#
#   --target app  -> php-fpm con el código, el vendor sin dev y los assets compilados
#   --target web  -> Caddy con `public/`, TLS automático y FastCGI hacia `app`
#
# Ambas imágenes deben publicarse y desplegarse con la MISMA etiqueta. Caddy
# resuelve las rutas de los assets y le pasa a php-fpm el `index.php` que
# encuentra en su propia copia de `public/`: si las etiquetas se desfasan se
# sirve HTML nuevo contra PHP viejo (o al revés) y el fallo es silencioso.

##########################  1. Assets de Vite  ##########################
FROM node:22-bookworm-slim AS assets

RUN corepack enable && corepack prepare pnpm@11.18.0 --activate

WORKDIR /var/www/html

# Solo los manifiestos primero: mientras el lockfile no cambie, esta capa se
# reutiliza y `pnpm install` no vuelve a ejecutarse.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

#######################  2. Dependencias de PHP  ########################
FROM composer:2 AS vendor

WORKDIR /var/www/html

# `--no-scripts` porque `package:discover` necesita las extensiones nativas
# (pdo_pgsql, bcmath) que solo existen en la imagen final; se ejecuta allí.
COPY composer.json composer.lock ./
RUN composer install \
        --no-dev \
        --no-scripts \
        --no-autoloader \
        --prefer-dist \
        --no-interaction \
        --no-progress

COPY . .
RUN composer dump-autoload \
        --no-dev \
        --no-scripts \
        --optimize \
        --classmap-authoritative

##########################  3. Runtime php-fpm  #########################
FROM php:8.3-fpm-bookworm AS app

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends libpq-dev libzip-dev; \
    docker-php-ext-install -j"$(nproc)" bcmath opcache pdo_pgsql zip; \
    rm -rf /var/lib/apt/lists/*

COPY docker/php/opcache.prod.ini /usr/local/etc/php/conf.d/opcache.ini
COPY docker/php/php.prod.ini     /usr/local/etc/php/conf.d/app.ini

WORKDIR /var/www/html

COPY --from=vendor /var/www/html/vendor ./vendor
COPY . .
COPY --from=assets /var/www/html/public/build ./public/build

# `storage/` y `bootstrap/cache/` quedan fuera del contexto de build (ver
# .dockerignore: son estado local), así que el árbol se recrea vacío aquí.
# Tiene que existir ANTES de `package:discover`, que escribe packages.php.
RUN set -eux; \
    mkdir -p \
        storage/app/public \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache; \
    php artisan package:discover --ansi; \
    chown -R www-data:www-data storage bootstrap/cache

COPY docker/php/entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

EXPOSE 9000

ENTRYPOINT ["entrypoint"]
CMD ["php-fpm"]

############################  4. Caddy (web)  ###########################
FROM caddy:2-alpine AS web

COPY docker/caddy/Caddyfile /etc/caddy/Caddyfile
COPY --from=assets /var/www/html/public /var/www/html/public

EXPOSE 80 443
