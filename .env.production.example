# Plantilla del .env que vive en el servidor, junto a compose.prod.yaml.
# Copiar como `.env`, completar y dejarlo con permisos 600 (contiene la clave
# de la aplicación y la de la base de datos). Nunca se versiona.

# --- Imagen a desplegar -------------------------------------------------
# IMAGE_TAG lo reescribe el workflow de despliegue en cada corrida con el SHA
# del commit; el valor de aquí solo es el punto de partida / rollback manual.
IMAGE_REPOSITORY=ghcr.io/aframuz/bdp-user-management
IMAGE_TAG=latest

# --- Publicación --------------------------------------------------------
APP_DOMAIN=usuarios.ejemplo.cl
ACME_EMAIL=tu-correo@ejemplo.cl

# --- Laravel ------------------------------------------------------------
APP_NAME="Mantenedor de Usuarios"
APP_ENV=production
# Generar con: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Santiago
APP_URL=https://usuarios.ejemplo.cl

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

# --- Base de datos ------------------------------------------------------
# DB_HOST es el nombre del servicio de compose, no localhost.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=usuarios
DB_USERNAME=usuarios
DB_PASSWORD=

# --- Infraestructura de Laravel ----------------------------------------
# `cache` sí tiene migración; `sessions` no (este proyecto no incluye la
# migración de auth de Laravel), así que las sesiones van a disco sobre el
# volumen `app_storage`, que sobrevive a los redeploys.
CACHE_STORE=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
