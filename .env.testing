APP_NAME="Mantenedor de Usuarios"
APP_ENV=testing
APP_KEY=base64:K2H8fSoKvaDg7fjH5HkbQhZ2B2eI4f8Z5f0xWlJ6FRE=
APP_DEBUG=false
APP_URL=http://app-test:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

DB_CONNECTION=pgsql
DB_HOST=db-test
DB_PORT=5432
DB_DATABASE=usuarios_test
DB_USERNAME=usuarios
DB_PASSWORD=usuarios

CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
# El servidor E2E (app-test) necesita sesiones persistentes: `php artisan serve`
# solo propaga una lista blanca de variables a su proceso hijo, así que las de
# compose no llegan y este archivo es la única fuente. Sin esto el token CSRF se
# regenera en cada petición y todo POST responde 419.
# PHPUnit sigue usando el driver `array` (definido en phpunit.xml).
SESSION_DRIVER=file
